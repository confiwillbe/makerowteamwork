# Add these in Vercel Project → Settings → Environment Variables.
# Connect a Neon PostgreSQL database first; Neon integration supplies DATABASE_URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Created automatically on the first API request if no admin exists.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_AT_LEAST_16_CHARS

# Server-only API tokens. Never prefix these with VITE_ or NEXT_PUBLIC_.
LZT_API_TOKEN=PASTE_LZT_MARKET_API_TOKEN
STRATZ_API_TOKEN=PASTE_STRATZ_API_TOKEN
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=1573865134806270074

COOKIE_SECURE=true
NODE_ENV=production
